---
import Base from '../../layouts/Base.astro';
import LessonCard from '../../components/LessonCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SUBJECTS, LEVELS, readyLessons, type Subject } from '../../config';
export function getStaticPaths() { return SUBJECTS.map((s) => ({ params: { subject: s.id }, props: { s } })); }
const { s } = Astro.props as { s: Subject };
const lessons = readyLessons().filter((l) => l.subject === s.id);
const levels = LEVELS.filter((lv) => lv.open);
---
<Base title={s.name} description={`${s.name} picture lessons for K2 to P2: ${s.blurb}`} subject={s.id}>
  <div class="wrap">
    <div class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><span>{s.name}</span></nav>
      <div class="subject-hero">
        <span class="stile-icon" aria-hidden="true">{s.icon}</span>
        <div><h1>{s.name}{s.lang === 'ta' && s.tamil && <span class="ta muted" lang="ta" style="font-size:.5em"> {s.tamil}</span>}</h1><p class="lede">{s.blurb}</p></div>
      </div>
      <div class="levels" aria-label="Jump to level">{levels.map((lv) => <a href={`/${s.id}/${lv.id}/`}>{lv.name} <span class="muted">&nbsp;· age {lv.age}</span></a>)}</div>
    </div>
    <div class="stack">
      {levels.map((lv) => {
        const ls = lessons.filter((l) => l.level === lv.id);
        return (
          <section class="level-block" id={lv.id}>
            <div class="level-title"><h2>{lv.name}</h2><span class="age">{lv.long} · age {lv.age}</span></div>
            {ls.length ? <div class="lgrid">{ls.map((l) => <LessonCard lesson={l} />)}</div> : <p class="soon">New {s.name} lessons for {lv.name} are on the way.</p>}
          </section>
        );
      })}
    </div>
  </div>
  <AdSlot />
</Base>
