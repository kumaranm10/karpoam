---
import Base from '../layouts/Base.astro';
import LessonCard from '../components/LessonCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, SUBJECTS, LEVELS, readyLessons, subjectById } from '../config';
import { homeLessons } from '../lib/home';
const lessons = readyLessons();
const count = (id: string) => lessons.filter((l) => l.subject === id).length;
// Hero picture and sums come from the same two numbers, so they can never disagree.
const plates = 3;
const perPlate = 4;
const total = plates * perPlate;
const plateList = Array.from({ length: plates }, (_, i) => i);
const cookieList = Array.from({ length: perPlate }, (_, i) => i);
const home = homeLessons(lessons, LEVELS.map((l) => l.id));
---
<Base title={SITE.name}>
  <section class="band band-hero">
    <div class="wrap hero">
      <div class="hero-copy">
        <span class="eyebrow">Free · Ages 5–8 · K2 to P2</span>
        <h1>Learn by <span class="hl">seeing, tapping</span> and doing.</h1>
        <p class="lede">Short picture lessons with real things your child knows: cookies, cars, coins and pets. One sentence at a time, read aloud.</p>
        <div class="hero-ctas">
          <a class="btn go" href="/maths/">Start with Maths</a>
          <a class="btn" href="/parents/">How it works</a>
        </div>
      </div>
      <div class="hero-demo" role="img" aria-label={`${plates} plates with ${perPlate} cookies each: ${plateList.map(() => perPlate).join(' plus ')} equals ${total}, so ${plates} times ${perPlate} equals ${total}`}>
        <div class="demo-plates" aria-hidden="true">
          {plateList.map(() => <span class="demo-plate">{cookieList.map(() => <span class="demo-cookie">🍪</span>)}</span>)}
        </div>
        <div class="demo-eq" aria-hidden="true">{plateList.map((i) => <>{i > 0 && ' + '}<span class="ec">{perPlate}</span></>)} = {total}</div>
        <div class="demo-times" aria-hidden="true"><span class="g">{plates}</span> × <span class="o">{perPlate}</span> = {total}</div>
        <p class="muted">{plates} plates of {perPlate} cookies</p>
      </div>
    </div>
  </section>

  <section class="band band-subjects" aria-labelledby="subj-h">
    <div class="wrap section">
      <h2 id="subj-h">Pick a subject</h2>
      <div class="subjects">
        {SUBJECTS.map((s) => (
          <a class="stile" href={`/${s.id}/`} data-subject={s.id}>
            <span class="stile-icon" aria-hidden="true">{s.icon}</span>
            <span class="stile-name">{s.name}</span>
            <span class="stile-blurb">{s.blurb}</span>
            <span class="stile-count">{count(s.id) ? `${count(s.id)} ${count(s.id) === 1 ? 'lesson' : 'lessons'} →` : 'Coming soon'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-lessons" aria-labelledby="new-h">
    <div class="wrap section">
      <h2 id="new-h">Lessons to try</h2>
      <div class="lgrid">
        {home.lessons.map((l) => <LessonCard lesson={l} showSubject />)}
        {home.seeAll.map((a) => (
          <a class="lcard" href={`/${a.subject}/`} data-subject={a.subject} data-see-all>
            <span class="lc-icon" aria-hidden="true">{subjectById(a.subject).icon}</span>
            <span class="lc-body">
              <span class="lc-meta">{subjectById(a.subject).name}</span>
              <span class="lc-title">See all {a.total} lessons →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-how" aria-labelledby="how-h">
    <div class="wrap section">
      <h2 id="how-h">Every lesson has 4 parts</h2>
      <ol class="how">
        <li><span class="hn">Part 1</span><span class="hi" aria-hidden="true">👀</span><span class="ht">See</span><span class="muted">A tiny story with real things, one sentence per screen.</span></li>
        <li><span class="hn">Part 2</span><span class="hi" aria-hidden="true">👆</span><span class="ht">Try</span><span class="muted">Your child taps and builds it with their own hands.</span></li>
        <li><span class="hn">Part 3</span><span class="hi" aria-hidden="true">✅</span><span class="ht">Check</span><span class="muted">A picture quiz that explains every answer.</span></li>
        <li><span class="hn">Part 4</span><span class="hi" aria-hidden="true">🏠</span><span class="ht">At home</span><span class="muted">Questions for parents to ask about real things.</span></li>
      </ol>
    </div>
  </section>
  <AdSlot />
</Base>
