{
  "name": "karpoam",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/check-lessons.mjs",
    "build": "node scripts/check-lessons.mjs && astro build",
    "preview": "astro preview --port 4321",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "budget": "node scripts/budget.mjs",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run budget && npm run e2e"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
