// Cloudflare Workers static-assets config. Cloudflare runs `npm run build`, then `npx wrangler deploy`
// publishes ./dist. No server code: the site is plain files.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karpoam",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
